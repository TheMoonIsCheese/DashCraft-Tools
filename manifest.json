{
  "name": "DashCraft Tools",
  "description": "Mods for DashCraft.io",
  "version": "3.0",
  "manifest_version": 3,
  "icons": {
    "128": "icon.png"
  },
  "externally_connectable": {
    "ids": ["*"],
    "matches": ["https://dashcraft.io/*"]
  },
  "content_scripts": [
    {
      "matches": ["https://dashcraft.io/*"],
      "js": ["injectedscript.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "activeTab",
    "declarativeContent",
    "storage"
  ],
  "host_permissions": [
    "https://dashcraft.io/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_icon": "icon.png"
  }
}
